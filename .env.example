NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:5173

MONGODB_URI=mongodb://127.0.0.1:27017/syncblaze

JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

PAIRING_SESSION_TTL_SECONDS=120

# Optional: enables "Sign in with Google". Leave blank to disable it.
# Only the Client ID is needed here (not the Client Secret) — we verify
# Google's ID token directly rather than doing a server-side code exchange.
GOOGLE_CLIENT_ID=

# Optional: a SEPARATE "Desktop app" type OAuth client (PKCE, system-browser
# flow), only needed if the desktop companion app's Google sign-in is wired
# up. GOOGLE_DESKTOP_CLIENT_SECRET is a real secret, unlike the client ID.
GOOGLE_DESKTOP_CLIENT_ID=
GOOGLE_DESKTOP_CLIENT_SECRET=

UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=200

# Comma-separated emails allowed to use /api/admin (and the /admin page).
# Leave blank to disable admin access entirely.
ADMIN_EMAILS=you@example.com

# Optional: enables all transactional email (welcome, login notices, room
# invites, note-shared notices, and the admin "send email" action), via
# Resend (https://resend.com). Leave blank to disable — the app works the
# same either way, it just skips sending those emails.
RESEND_API_KEY=
EMAIL_FROM=SyncBlaze <onboarding@resend.dev>

# Optional: enables real push notifications (delivered even when the app is
# closed). Generate a pair with `bunx web-push generate-vapid-keys`. Leave
# blank to disable — in-app notifications still work fine without these.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@syncblaze.app
