NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:5173

MONGODB_URI=mongodb://127.0.0.1:27017/syncblaze

JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

PAIRING_SESSION_TTL_SECONDS=120

# Optional: enables "Sign in with Google". Leave blank to disable it.
# Only the Client ID is needed here (not the Client Secret) — we verify
# Google's ID token directly rather than doing a server-side code exchange.
GOOGLE_CLIENT_ID=

UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=200
